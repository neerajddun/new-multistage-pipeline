pipeline {

    agent any 

    environment {

        IMAGE_NAME = "flask-app"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages { 

        stage('checkout') {

            steps { 

                checkout scm
            }
        }

        stage ('docker and test') {

            steps {

                sh '''

                docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                docker tag ${IMAGE_NAME}:${IMAGE_TAG} neeraj91/${IMAGE_NAME}:${IMAGE_TAG}
                docker tag  ${IMAGE_NAME}:${IMAGE_TAG} neeraj91/${IMAGE_NAME}:latest
                
                '''
            }
        }

        stage ('docker push') {

            steps {

                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', passwordVariable: 'DockerPass', usernameVariable: 'DockerName')]) {
                
                sh 'echo ${DockerPass} | docker login -u ${DockerName} --password-stdin'
                
                }
            }
        }
    }

    post {

        always {

            cleanWs()
        }
    }
}