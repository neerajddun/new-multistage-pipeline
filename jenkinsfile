pipeline {

    agent any 

    environment {

        IMAGE_NAME = "flask-app"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages { 

        stage('checkout') {

            steps { 

                checkout scm
            }
        }

        stage ('docker and test') {

            steps {

                sh '''

                docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                docker tag ${IMAGE_NAME}:${IMAGE_TAG} neeraj91/${IMAGE_NAME}:${IMAGE_TAG}
                docker tag  ${IMAGE_NAME}:${IMAGE_TAG} neeraj91/${IMAGE_NAME}:latest
                
                '''
            }
        }

        stage ('docker push') {

            steps {

                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', passwordVariable: 'DockerPass', usernameVariable: 'DockerName')]) {
                
                sh 'echo ${DockerPass} | docker login -u ${DockerName} --password-stdin'
                sh 'docker push neeraj91/${IMAGE_NAME}:${IMAGE_TAG}'
                sh 'docker push neeraj91/${IMAGE_NAME}:latest '
                
                }
            }
        }

        
        stage('Deploy to staging') {

            when {

                branch 'staging'
            }

            steps {

                sh 'docker rm -f flask-staging || true' 
                sh 'docker run -d --name flask-staging -p 5001:5000 ${IMAGE_NAME}:${IMAGE_TAG}'
                timeout(time: 10, unit: 'MINUTES') {
                    input message: 'Finished checking the staging site on port 5001? (Click "Proceed" to stop it)'
                }
            }
        }

        stage('Deploy to prod') {
            
            when {
           
                branch 'prod'
           
            }
           
            steps {
           
                input message: 'Deploy to production?', ok: 'Deploy'
                sh 'docker rm -f flask-prod || true'
                sh 'docker run -d --name flask-prod -p 5002:5000 ${IMAGE_NAME}:${IMAGE_TAG}'
           
            }
        }
    }

    post {

        always {

            cleanWs()
        }
    }
}